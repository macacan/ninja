# Lootninja Hostinger Web Configuration

# 1. Custom 404 Error Page
ErrorDocument 404 /404.html

# 2. Force UTF-8 Charset
AddDefaultCharset UTF-8
AddType application/manifest+json .webmanifest
AddType text/markdown .md

# 3. Security: Block hidden files, dev files, and scripts if accidentally uploaded
<FilesMatch "(^\.|\.(cmd|sh|md|yml|yaml|mjs|env|log|bak|config))$">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
</FilesMatch>
# Except index.md: the homepage as Markdown for AI agents (see 4a). Every other .md file stays blocked.
<Files "index.md">
  <IfModule mod_authz_core.c>
    Require all granted
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order deny,allow
    Allow from all
  </IfModule>
</Files>

# Block access to internal directories if accidentally uploaded to public_html
RedirectMatch 403 ^/(research|scripts|\.github|\.claude)/

# 4. One address for the whole site: https://lootninja.se (no www), so search engines never see duplicates.
# www goes straight to https without www, in a single redirect.
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
  RewriteRule ^ https://%1%{REQUEST_URI} [L,R=301]
  RewriteCond %{HTTPS} off
  RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  # 4a. AI agents that ask for Markdown (Accept: text/markdown) get the homepage as index.md. Browsers never send it.
  RewriteCond %{HTTP_ACCEPT} text/markdown [NC]
  RewriteRule ^(index\.html)?$ /index.md [L]

  # /index.html and /set/index.html are duplicates of / and /set/. Only when the visitor asked for them
  # (THE_REQUEST), not when Apache serves index.html for "/" internally, which would loop.
  RewriteCond %{THE_REQUEST} \s/(([^?\s]*/)?)index\.html[?\s]
  RewriteRule ^ /%1 [L,R=301]

  # Addresses without .html (lootninja.se/butiker, /set/151) go to the real page instead of a 404.
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{DOCUMENT_ROOT}/$1.html -f
  RewriteRule ^([a-z0-9/_-]+?)/?$ /$1.html [L,R=301]
</IfModule>

# 4b. No directory listings (e.g. /fonts/, /data/card-history/)
Options -Indexes

# 4c. Security headers
<IfModule mod_headers.c>
  # Points agents to the site summary (RFC 8288). The homepage also links its Markdown version, picked by Accept.
  <FilesMatch "\.html$">
    Header set Link '</llms.txt>; rel="describedby"; type="text/plain"'
  </FilesMatch>
  <FilesMatch "^index\.(html|md)$">
    Header set Link '</llms.txt>; rel="describedby"; type="text/plain", </index.md>; rel="alternate"; type="text/markdown"'
    Header append Vary Accept
  </FilesMatch>
  # Browsers only use HTTPS for a year after the first visit. Remove "max-age" if the site ever has to go back to HTTP.
  Header always set Strict-Transport-Security "max-age=31536000"
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  # Camera only for our own pages (card scanner); no microphone, location or payment APIs.
  Header always set Permissions-Policy "camera=(self), microphone=(), geolocation=(), payment=(), usb=()"
  # Full policy, enforced. Tested clean on every page and through the card scanner's OCR worker (blob worker + WASM).
  # Adding a new external script, font or iframe source? Add its host here too, or the browser will block it.
  # If something breaks in production, rename the header to Content-Security-Policy-Report-Only to stop blocking.
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' 'wasm-unsafe-eval' blob: https://cdn.jsdelivr.net https://cdn.tailwindcss.com; worker-src 'self' blob: https://cdn.jsdelivr.net; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https:; font-src 'self'; connect-src 'self' https:; media-src 'self' blob:; frame-src https://www.youtube-nocookie.com; object-src 'none'; base-uri 'self'; frame-ancestors 'self'; form-action 'self'"
</IfModule>

# 5. Gzip Compression
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css application/javascript application/json image/svg+xml
</IfModule>

# 6. Browser Caching
<IfModule mod_headers.c>
  # Dynamic data files (products, prices, news) should never be stale in browser cache.
  # Search engines may fetch them to render the pages, but should not list them as search results.
  <FilesMatch "\.(json)$">
    Header set Cache-Control "no-cache, must-revalidate"
    Header set X-Robots-Tag "noindex"
  </FilesMatch>

  # The sitemap changes at most once a day
  <FilesMatch "^sitemap\.xml$">
    Header set Cache-Control "max-age=3600, must-revalidate"
  </FilesMatch>

  # HTML pages revalidate quickly
  <FilesMatch "\.(html)$">
    Header set Cache-Control "max-age=600, must-revalidate"
  </FilesMatch>

  # Code and styling: always revalidate (a cheap 304 when unchanged). With a long max-age, a phone kept an old
  # butiker.js for weeks while the HTML was new, and the page crashed without showing any products.
  <FilesMatch "\.(css|js)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>

  # Images and fonts rarely change and can be cached longer
  <FilesMatch "\.(svg|jpg|jpeg|png|webp|gif|ico|woff|woff2|ttf)$">
    Header set Cache-Control "max-age=2592000, public"
  </FilesMatch>
</IfModule>
